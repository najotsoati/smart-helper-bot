ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Ixtiyoriy: trenddagi Shorts'larni topish uchun, bepul (https://console.cloud.google.com -> YouTube Data API v3)
YOUTUBE_API_KEY=
# Ixtiyoriy, lekin tavsiya: AI chizmalar uchun (https://platform.openai.com). Bo'sh bo'lsa faqat stok video ishlatiladi.
