# Copy to .env on the server and fill in.  Never commit .env.

# Panel login (open the panel in the browser with these)
PANEL_USER=admin
PANEL_PASSWORD=change-me-to-a-long-password

# Same token goes into agent/agent.ini on the laptop (any long random text)
AGENT_TOKEN=change-me-random-64-chars

# Public address of the panel, e.g. https://1-2-3-4.sslip.io
PUBLIC_URL=

# --- AI ---
OPENROUTER_API_KEY=
# Empty = use the free models OpenRouter lists today. Or name them, comma separated.
OPENROUTER_MODELS=
# Optional paid model for better jokes (writer, director). Free models are used if it fails.
OPENROUTER_STRONG_MODELS=
# 50 free requests a day, 1000 after a one-time $10 top-up
OPENROUTER_DAILY_FREE=50

# Grok as the backup (check the exact model id in console.x.ai)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning

# More free AI (each optional; used before OpenRouter's free models):
# Google AI Studio (aistudio.google.com), Mistral "Experiment" plan, Groq, Cerebras
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- Voice ---
# edge = free;  elevenlabs = Sticky's channel voice (Liam), paid plan for a monetised channel
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
